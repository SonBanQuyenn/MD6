# Sao chép file này thành .env rồi chỉnh sửa:  cp .env.example .env
# .env đã nằm trong .gitignore — KHÔNG BAO GIỜ commit file .env.
# Các giá trị dưới đây chỉ dùng cho môi trường phát triển cục bộ.

# ---------- Docker Compose (dev) ----------
POSTGRES_USER=shopfast
POSTGRES_PASSWORD=shopfast_dev_password
POSTGRES_DB=shopfast
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- Backend ----------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shopfast:shopfast_dev_password@localhost:5432/shopfast?schema=public
REDIS_URL=redis://localhost:6379
