# Sao chép file này thành .env rồi chỉnh sửa:  cp .env.example .env
# .env đã nằm trong .gitignore — KHÔNG BAO GIỜ commit file .env.
# Các giá trị dưới đây chỉ dùng cho môi trường phát triển cục bộ.

# ---------- Docker Compose (dev) ----------
POSTGRES_USER=shopfast
POSTGRES_PASSWORD=shopfast_dev_password
POSTGRES_DB=shopfast
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- Backend ----------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shopfast:shopfast_dev_password@localhost:5432/shopfast?schema=public
REDIS_URL=redis://localhost:6379

# ---------- Xác thực ----------
# Bí mật ký JWT, tối thiểu 32 ký tự. Tạo chuỗi ngẫu nhiên bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# COOKIE_SECURE mặc định false khi dev, true khi production.

# Tài liệu API tại /api/docs
SWAGGER_ENABLED=true

# ---------- Rate limit (F03) ----------
RATE_LIMIT_GLOBAL_PER_MINUTE=100
# Đặt 1 khi app chạy sau Nginx (production). Giữ 0 khi chạy trực tiếp.
TRUST_PROXY=0

# ---------- Trợ lý AI (F01) ----------
# mock = kịch bản cố định, KHÔNG phải AI thật. Đổi sang anthropic + điền key để dùng Claude.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=20000

# ---------- Seed dữ liệu mẫu (chỉ dev/demo) ----------
SEED_PASSWORD=ShopFast@2026

# ---------- Email (dev dùng Mailpit trong docker-compose) ----------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShopFast <no-reply@shopfast.local>

# ---------- Tác vụ nền (BullMQ) ----------
# 30 phút theo SRS. Khi demo có thể đặt 60000 (1 phút).
PAYMENT_REMINDER_DELAY_MS=1800000
DAILY_REPORT_CRON=0 23 * * *
# 0 = đối tác kho luôn thành công; 1 = luôn lỗi (demo retry + dead letter)
PARTNER_SYNC_FAILURE_RATE=0
