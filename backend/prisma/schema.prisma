// Schema Prisma của ShopFast.
// Thiết kế đầy đủ: docs/database-design.md — các model được thêm dần theo từng phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 4 vai trò theo SRS mục 2 (User Classes)
enum Role {
  CUSTOMER
  SUPPORT_AGENT
  WAREHOUSE_STAFF
  ADMIN
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  role          Role     @default(CUSTOMER)
  emailVerified Boolean  @default(false) @map("email_verified")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens      RefreshToken[]
  cartItems          CartItem[]
  orders             Order[]
  statusChanges      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

/// Refresh token: chỉ lưu HASH (SHA-256), không lưu token gốc.
/// Mỗi lần refresh → token cũ bị thu hồi (revokedAt) và trỏ sang token mới (replacedById).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Danh mục sản phẩm (một cấp — xem docs/database-design.md)
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

/// Giá lưu bằng số nguyên VND. Ràng buộc CHECK (price >= 0, stock >= 0) nằm trong migration SQL.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique
  name        String
  slug        String   @unique
  description String   @default("")
  price       Int
  stock       Int      @default(0)
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  /// Tăng mỗi lần giá/tồn kho đổi — dùng cho cache (Phase 7)
  version     Int      @default(1)
  categoryId  String   @map("category_id") @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId, price])
  @@index([brandId, price])
  @@index([isActive, createdAt(sort: Desc)])
  @@map("products")
}

// ======================= Giỏ hàng & Đơn hàng (F06.2, F06.3) =======================

/// Mỗi dòng = 1 sản phẩm trong giỏ của 1 khách. Không cần bảng "carts" riêng.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

/// Mã khuyến mãi có giới hạn lượt dùng (dùng cho POST /orders/promotional).
model Promotion {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  description     String   @default("")
  /// Phần trăm giảm, 1–90
  discountPercent Int      @map("discount_percent")
  /// Giảm tối đa (VND); null = không giới hạn
  maxDiscount     Int?     @map("max_discount")
  maxUses         Int      @map("max_uses")
  usedCount       Int      @default(0) @map("used_count")
  perUserLimit    Int      @default(1) @map("per_user_limit")
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  orders Order[]

  @@map("promotions")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  MOCK_ONLINE
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  /// Mã dễ đọc cho khách/nhân viên, ví dụ SF-20261101-7K2QX9AB
  code            String        @unique
  userId          String        @map("user_id") @db.Uuid
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod   PaymentMethod @map("payment_method")
  subtotal        Int
  discount        Int           @default(0)
  total           Int
  promotionId     String?       @map("promotion_id") @db.Uuid
  /// Khoá chống đặt trùng (header Idempotency-Key), duy nhất theo từng khách
  idempotencyKey  String        @map("idempotency_key")
  shippingAddress Json          @map("shipping_address")
  note            String?
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  promotion          Promotion?           @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  invoice            Invoice?
  emailLogs          EmailLog[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("orders")
}

/// Lưu BẢN CHỤP tên + giá lúc đặt → đổi giá sản phẩm sau này không làm thay đổi đơn cũ.
model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  productName String @map("product_name")
  sku         String
  unitPrice   Int    @map("unit_price")
  quantity    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum InventoryReason {
  ORDER
  CANCEL
  MANUAL_ADJUST
  PARTNER_SYNC
}

/// Nhật ký mọi lần tồn kho thay đổi → truy vết được "vì sao còn N sản phẩm".
model InventoryMovement {
  id         String          @id @default(uuid()) @db.Uuid
  productId  String          @map("product_id") @db.Uuid
  delta      Int
  stockAfter Int             @map("stock_after")
  reason     InventoryReason
  orderId    String?         @map("order_id") @db.Uuid
  actorId    String?         @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

// ======================= Tác vụ nền (F05) =======================

enum OutboxEventType {
  ORDER_PLACED
  ORDER_CANCELLED
}

/// Transactional outbox: sự kiện được ghi CÙNG transaction với đơn hàng.
/// Redis/hàng đợi hỏng đúng lúc đặt đơn → sự kiện vẫn nằm đây, job quét định kỳ sẽ đẩy lại.
model JobOutbox {
  id           String          @id @default(uuid()) @db.Uuid
  type         OutboxEventType
  orderId      String          @map("order_id") @db.Uuid
  payload      Json
  dispatchedAt DateTime?       @map("dispatched_at") @db.Timestamptz(3)
  attempts     Int             @default(0)
  lastError    String?         @map("last_error")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([dispatchedAt, createdAt])
  @@map("job_outbox")
}

enum EmailStatus {
  SENDING
  SENT
  FAILED
}

/// Nhật ký email. `dedupeKey` UNIQUE = chốt chặn "mỗi đơn chỉ 1 email xác nhận" dù job chạy lại.
model EmailLog {
  id                String      @id @default(uuid()) @db.Uuid
  /// ví dụ: order-confirmation-<orderId>, payment-reminder-<orderId>, daily-report-2026-11-01-<email>
  dedupeKey         String      @unique @map("dedupe_key")
  type              String
  orderId           String?     @map("order_id") @db.Uuid
  toEmail           String      @map("to_email")
  subject           String
  status            EmailStatus @default(SENDING)
  attempts          Int         @default(0)
  providerMessageId String?     @map("provider_message_id")
  lastError         String?     @map("last_error")
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

/// Hoá đơn: mỗi đơn đúng 1 hoá đơn (orderId UNIQUE). Nội dung HTML lưu trong DB.
model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  number    String   @unique
  total     Int
  html      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

/// Mỗi lần đồng bộ tồn kho với đối tác thành công được ghi lại theo khoá chống trùng.
model InventorySyncLog {
  id         String   @id @default(uuid()) @db.Uuid
  dedupeKey  String   @unique @map("dedupe_key")
  orderId    String?  @map("order_id") @db.Uuid
  payload    Json
  partnerRef String   @map("partner_ref")
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  @@map("inventory_sync_logs")
}

/// "Dead letter": job đã hết lượt thử, lưu kèm lý do để admin xem và chạy lại.
model FailedJob {
  id           String    @id @default(uuid()) @db.Uuid
  queue        String
  jobId        String    @map("job_id")
  jobName      String    @map("job_name")
  payload      Json
  failedReason String    @map("failed_reason")
  stacktrace   String?
  attemptsMade Int       @map("attempts_made")
  failedAt     DateTime  @default(now()) @map("failed_at") @db.Timestamptz(3)
  retriedAt    DateTime? @map("retried_at") @db.Timestamptz(3)

  @@index([queue, failedAt(sort: Desc)])
  @@map("failed_jobs")
}

/// Báo cáo doanh thu theo ngày (giờ Việt Nam). reportDate UNIQUE → chạy lại chỉ cập nhật, không nhân đôi.
model DailyRevenueReport {
  id             String   @id @default(uuid()) @db.Uuid
  reportDate     DateTime @unique @map("report_date") @db.Date
  orderCount     Int      @map("order_count")
  cancelledCount Int      @map("cancelled_count")
  /// BigInt: doanh thu 1 ngày có thể vượt giới hạn INTEGER (~2,1 tỷ đồng)
  revenue        BigInt
  breakdown      Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("daily_revenue_reports")
}
