{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<BACKUP_BUCKET>",
        "arn:aws:s3:::<BACKUP_BUCKET>/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyDeleteBackups",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::<BACKUP_BUCKET>/postgres/*",
      "Condition": {
        "StringNotLike": { "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_ID>:role/<ADMIN_ROLE>" }
      }
    }
  ]
}
