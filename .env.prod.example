# Mẫu biến môi trường PRODUCTION. Trên EC2, file .env.prod được TẠO từ AWS SSM Parameter Store
# bởi infra/deploy/fetch-env.sh — KHÔNG commit giá trị thật, không chép tay mật khẩu vào đây.
# Chạy thử cục bộ: cp .env.prod.example .env.prod rồi đổi các giá trị change-me.

DOMAIN=
POSTGRES_USER=shopfast
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=shopfast
REDIS_PASSWORD=change-me-redis

DATABASE_URL=postgresql://shopfast:change-me-postgres@postgres:5432/shopfast?schema=public
REDIS_URL=redis://:change-me-redis@redis:6379

JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=true
SWAGGER_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# Demo: Mailpit trong mạng nội bộ. Production thật: đổi sang SMTP của nhà cung cấp (SES, …)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=ShopFast <no-reply@shopfast.local>

AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

SEED_PASSWORD=change-me-seed
